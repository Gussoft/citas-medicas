						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"indicacionesGenerales\": \"Tomar los medicamentos despues de los alimentos. Ingerir abundante liquido.\",\n    \"detalles\": [\n        {\n            \"medicamento\": \"Amoxicilina 500mg\",\n            \"dosis\": \"1 tableta (500mg)\",\n            \"frecuencia\": \"Cada 8 horas\",\n            \"duracion\": \"7 dias\",\n            \"cantidad\": 21\n        },\n        {\n            \"medicamento\": \"Paracetamol 500mg\",\n            \"dosis\": \"1 tableta (500mg)\",\n            \"frecuencia\": \"Cada 8 horas si hay fiebre o dolor\",\n            \"duracion\": \"3 dias\",\n            \"cantidad\": 10\n        }\n    ]\n}"
				},
				"url": {
